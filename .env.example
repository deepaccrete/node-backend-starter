# ─────────────────────────────────────────────────────────────────────
#
#  1. Copy this file to `.env`
#  2. Fill in EVERY value marked (required)
#  3. Then: pnpm dev
#
#  Connection settings and secrets have no built-in default. The server checks
#  these at startup and refuses to boot with a message naming whatever is
#  missing, rather than connecting to the wrong database and failing later.
#
#  `.env` is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# (required) port this API listens on. The frontend dev server proxies /api to it.
PORT=

# Which network interface to listen on.
#   0.0.0.0    every interface (localhost AND the LAN address) — use in development
#   127.0.0.1  this machine only
HOST=0.0.0.0

# Mount prefix for every route; changing it moves the whole API at once.
API_PREFIX=/api/v1

# ─── PostgreSQL ──────────────────────────────────────────────────────
# (required) all four. docker-compose publishes its database on port 5433.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
# Keep this line even if your database has no password — leave it empty.
DB_PASSWORD=

DB_POOL_MIN=2
DB_POOL_MAX=10
# disable | require. `require` encrypts AND verifies the server certificate.
DB_SSL=disable
# Path to the database's CA certificate, when it is not in the system store.
DB_SSL_CA=

# ─── Authentication ──────────────────────────────────────────────────
# (required) two DIFFERENT random secrets, at least 32 characters each.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Agreed values: access token 15 minutes, refresh token 7 days.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Lock an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_FAILURES wrong passwords.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated allowlist, enforced in production only (required there).
CORS_ORIGIN=

# ─── Logging ─────────────────────────────────────────────────────────
# Production logs JSON to stdout only. Development also writes rotated files here.
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter bucket for /auth (login is worth brute-forcing).
AUTH_RATE_LIMIT_MAX=20

# ─── Uploads ─────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=5242880

# ─────────────────────────────────────────────────────────────────────
#  Add new variables here AND in src/config/env.ts — never read
#  `process.env` anywhere else.
# ─────────────────────────────────────────────────────────────────────
