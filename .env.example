# ─────────────────────────────────────────────────────────────────────
#
#  1. Copy this file to `.env`
#  2. Fill in EVERY value marked (required)
#  3. Then: pnpm dev
#
#  Connection settings and secrets have no built-in default. The server checks
#  these at startup and refuses to boot with a message naming whatever is
#  missing, rather than connecting to the wrong database and failing later.
#
#  `.env` is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# (required) port this API listens on. The frontend dev server proxies /api to it.
PORT=

# Which network interface to listen on.
#   0.0.0.0    every interface (localhost AND the LAN address) — use in development
#   127.0.0.1  this machine only
HOST=0.0.0.0

# Mount prefix for every route; changing it moves the whole API at once.
API_PREFIX=/api/v1

# ─── MongoDB ─────────────────────────────────────────────────────────
# (required) one connection string, and it must name the database.
#   docker-compose (local):  mongodb://localhost:27017/tpjp
#   Atlas:                   mongodb+srv://<user>:<password>@<cluster>/tpjp?retryWrites=true&w=majority
# Pool size, TLS and other options go in the string (e.g. ?maxPoolSize=10).
MONGODB_URI=

# @auth-start
# ─── Authentication ──────────────────────────────────────────────────
# (required) two DIFFERENT random secrets, at least 32 characters each.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Agreed values: access token 15 minutes, refresh token 7 days.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Lock an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_FAILURES wrong passwords.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# One-time codes (OTP) sent by SMS: app login, password reset, new contact numbers.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
# How SMS is sent. `log` writes the code to the server log; it refuses to send in
# production. A real provider is added here when Lotte confirms one.
SMS_PROVIDER=log
# @auth-end

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated allowlist, enforced in production only (required there).
CORS_ORIGIN=

# ─── Logging ─────────────────────────────────────────────────────────
# Production logs JSON to stdout only. Development also writes rotated files here.
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# @auth-start
# Stricter bucket for /auth (login is worth brute-forcing).
AUTH_RATE_LIMIT_MAX=20
# @auth-end

# ─── Uploads ─────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=5242880

# ─────────────────────────────────────────────────────────────────────
#  Add new variables here AND in src/config/env.ts — never read
#  `process.env` anywhere else.
# ─────────────────────────────────────────────────────────────────────
