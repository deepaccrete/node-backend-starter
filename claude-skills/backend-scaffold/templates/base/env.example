# ─────────────────────────────────────────────────────────────────────
#  {{PROJECT_NAME}} — environment
#
#  1. Copy this file to `.env`
#  2. Fill in EVERY value marked (required)
#  3. Then: npm run dev
#
#  Nothing here has a built-in default. The server checks these at startup
#  and refuses to boot with a message naming whatever is missing, rather
#  than connecting to the wrong database and failing later.
#
#  `.env` is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
# (required) port this API listens on
PORT=

# Which network interface to listen on.
#   0.0.0.0    every interface — http://localhost:PORT AND http://<lan-ip>:PORT
#              both work. This is what you want in development.
#   127.0.0.1  loopback only — this machine can reach it, nothing else can.
#   <lan-ip>   that ONE interface — the LAN address works and localhost is
#              REFUSED, which looks like a firewall problem and is not one.
HOST=0.0.0.0

# Mount prefix for every route. The route loader mounts each route module at
# ${API_PREFIX}${route.path}, so changing this moves the whole API at once.
API_PREFIX=/api/v1

# ─── PostgreSQL ──────────────────────────────────────────────────────
# (required) all four. The project makes no assumption about your setup.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
# Keep this line even if your database has no password — leave it empty.
DB_PASSWORD=

DB_POOL_MIN=2
DB_POOL_MAX=10
# Database TLS. `disable` = no TLS (local). `require` = TLS WITH certificate
# verification — use this when the database is remote (managed Postgres).
# `no-verify` = TLS without verification; only for a self-signed cert on a
# trusted network (it gives up man-in-the-middle protection).
DB_SSL=disable
# Path to the CA certificate file used to verify the server when DB_SSL=require.
# Managed providers give you this file. Leave blank to use the system CA store.
DB_SSL_CA=

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated allowlist, enforced in production only. In development every
# origin is allowed so a LAN device can hit the API without a config change.
# At least one entry is required when NODE_ENV=production.
CORS_ORIGIN=

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Uploads ─────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=5242880

# ─────────────────────────────────────────────────────────────────────
#  Add your own variables below as the project grows. Read them ONLY in
#  src/config/env.js — never `process.env` elsewhere — so a missing value
#  fails at boot instead of at the first request that needs it.
# ─────────────────────────────────────────────────────────────────────
